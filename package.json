{
  "name": "relation-blueprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Serverless, offline-capable PWA for people-tracking and relationship mapping. You own your entire database in your own Google Drive or Mega.nz — no backend, no accounts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",

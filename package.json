    "@radix-ui/react-dropdown-menu": "2.1.18",
    "browser-image-compression": "2.0.2",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "konva": "10.3.0",
    "lucide-react": "1.21.0",
    "nanoid": "5.1.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-konva": "19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
